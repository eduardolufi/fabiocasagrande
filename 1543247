// ===== Tilt 3D (só com rato) =====
if(FINE){
 const tilt=(el,max)=>{
  let raf=0,ev=null;
  el.addEventListener("pointermove",e=>{ev=e;if(raf)return;raf=requestAnimationFrame(()=>{
   raf=0;const r=el.getBoundingClientRect(),x=(ev.clientX-r.left)/r.width-.5,y=(ev.clientY-r.top)/r.height-.5;
   el.style.transform=`perspective(800px) rotateY(${x*max}deg) rotateX(${-y*max}deg)`;
  })});
  el.addEventListener("pointerleave",()=>{ev=null;el.style.transform=""});
 };
 tilt($("#tilt"),14);$$(".tc,.cc").forEach(e=>tilt(e,6));
}

// ===== Cursor (só com rato; anima apenas quando se move) =====
if(FINE){
 const c=$("#cur");let x=0,y=0,cx=0,cy=0,big=false,raf=0;
 function loop(){
  cx+=(x-cx)*.24;cy+=(y-cy)*.24;
  c.style.transform=`translate3d(${cx}px,${cy}px,0) scale(${big?1.8:1})`;
  raf=(Math.abs(x-cx)>.2||Math.abs(y-cy)>.2)?requestAnimationFrame(loop):0;
 }
 addEventListener("pointermove",e=>{x=e.clientX;y=e.clientY;c.classList.add("on");if(!raf)raf=requestAnimationFrame(loop)},{passive:true});
 document.addEventListener("pointerover",e=>{
  const b=!!e.target.closest("a,button,.gi,.pad,input");
  if(b!==big){big=b;c.classList.toggle("big",b);if(!raf)raf=requestAnimationFrame(loop)}
 });
}

// ===== Partículas (sprites pré-renderizados, 30fps, pausa quando a aba está oculta) =====
(function(){
 if(REDUCED)return;
 const cv=$("#fx"),ctx=cv.getContext("2d");
 let W,H,ps=[],mx=-999,my=-999,last=0,running=true;
 const cols=["0,229,255","139,92,246","255,45,149"];
 const sp=cols.map(c=>{const s=document.createElement("canvas");s.width=s.height=32;const x=s.getContext("2d");
  const g=x.createRadialGradient(16,16,0,16,16,16);g.addColorStop(0,`rgba(${c},1)`);g.addColorStop(.3,`rgba(${c},.5)`);g.addColorStop(1,`rgba(${c},0)`);
  x.fillStyle=g;x.fillRect(0,0,32,32);return s});
 function size(){
  W=cv.width=innerWidth;H=cv.height=innerHeight;
  const n=Math.min(W<700?22:44,Math.floor(W*H/26000));
  ps=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,s:Math.random()*14+6,v:Math.random()*.3+.08,c:Math.random()*3|0,a:Math.random()*.55+.25}));
 }
 size();let rt;addEventListener("resize",()=>{clearTimeout(rt);rt=setTimeout(size,200)});
 if(FINE)addEventListener("pointermove",e=>{mx=e.clientX;my=e.clientY},{passive:true});
 document.addEventListener("visibilitychange",()=>{running=!document.hidden;if(running)requestAnimationFrame(draw)});
 function draw(t){
  if(!running)return;
  requestAnimationFrame(draw);
  if(t-last<33)return;last=t;
  ctx.clearRect(0,0,W,H);
  for(const p of ps){
   p.y-=p.v*2;if(p.y<-20){p.y=H+20;p.x=Math.random()*W}
   const dx=p.x-mx,dy=p.y-my;
   if(dx*dx+dy*dy<12100){const d=Math.hypot(dx,dy)||1;p.x+=dx/d*3;p.y+=dy/d*3}
   ctx.globalAlpha=p.a;ctx.drawImage(sp[p.c],p.x-p.s/2,p.y-p.s/2,p.s,p.s);
  }
  ctx.globalAlpha=1;
 }
 requestAnimationFrame(draw);
})();

