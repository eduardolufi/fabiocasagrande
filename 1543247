// ===== Header, progresso, secção ativa (sem forçar layout no scroll) =====
const hd=$("#hd"),prog=$("#progress");
let maxS=0,tick=false;
function meas(){maxS=document.documentElement.scrollHeight-innerHeight}
meas();addEventListener("resize",meas);addEventListener("load",meas);
if("ResizeObserver" in window)new ResizeObserver(meas).observe(document.body);
function onScroll(){
 if(tick)return;tick=true;
 requestAnimationFrame(()=>{
  tick=false;const y=scrollY;
  hd.classList.toggle("sc",y>30);
  prog.style.transform="scaleX("+(maxS>0?Math.min(y/maxS,1):0)+")";
