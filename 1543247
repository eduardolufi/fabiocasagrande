<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#05060b">
<title>Fábio Casagrande | Produtor Musical</title>
<meta name="description" content="Portfólio de Fábio Casagrande, produtor musical versátil: trap, funk, pop, eletrónica e música latina.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#05060b;--bg2:#0a0c16;--c1:#00e5ff;--c2:#8b5cf6;--c3:#ff2d95;--tx:#e8ecf5;--mut:#8b93a7;--line:rgba(255,255,255,.09);--glass:rgba(14,17,30,.6);
--fd:'Orbitron','Segoe UI',system-ui,sans-serif;--fb:'Space Grotesk','Segoe UI',system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--tx);font-family:var(--fb);line-height:1.65;overflow-x:hidden;padding-bottom:env(safe-area-inset-bottom,0)}
img{max-width:100%;display:block}
a{color:inherit}
::selection{background:var(--c1);color:#000}
main,footer{position:relative;z-index:1}
.wrap{width:min(1200px,92%);margin:0 auto}
section{padding:clamp(70px,11vw,130px) 0;position:relative}
@media (hover:hover) and (pointer:fine){.cursor{display:block}}

/* header */

/* buttons - compact */
.btn{display:inline-flex;align-items:center;gap:8px;font:500 .78rem var(--fb);letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:9px 18px;border-radius:8px;border:1px solid var(--c1);color:var(--c1);background:rgba(0,229,255,.07);transition:.3s;cursor:pointer}
.btn:hover{background:var(--c1);color:#000;box-shadow:0 0 22px rgba(0,229,255,.55)}
.btn.alt{border-color:var(--line);color:var(--tx);background:transparent}
.btn.alt:hover{border-color:var(--c2);background:var(--c2);color:#fff;box-shadow:0 0 22px rgba(139,92,246,.5)}
.btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}

/* hero */
.hero{min-height:100svh;display:flex;align-items:center;padding-top:110px;padding-bottom:60px;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(900px 500px at 78% 40%,rgba(139,92,246,.22),transparent 70%),radial-gradient(700px 400px at 10% 90%,rgba(0,229,255,.12),transparent 70%)}
.hero-in{position:relative;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
h1{font-family:var(--fd);font-weight:900;line-height:1.02;font-size:clamp(2rem,9.4vw,4.6rem);letter-spacing:.01em;text-transform:uppercase}
h1 .glitch:last-child{background:linear-gradient(90deg,var(--c1),var(--c2) 55%,var(--c3));-webkit-background-clip:text;background-clip:text;color:transparent}
.glitch{position:relative;display:block}
.glitch::before,.glitch::after{content:attr(data-text);position:absolute;left:0;top:0;width:100%;overflow:hidden;-webkit-text-fill-color:currentColor}
.glitch::before{color:var(--c1);clip-path:inset(0 0 62% 0);animation:g1 3.2s infinite steps(1)}
.glitch::after{color:var(--c3);clip-path:inset(62% 0 0 0);animation:g2 2.7s infinite steps(1)}
@keyframes g1{0%,88%,100%{transform:translate(0);opacity:0}90%{transform:translate(-5px,1px);opacity:.9}94%{transform:translate(4px,-1px);opacity:.9}97%{opacity:0}}
@keyframes g2{0%,80%,100%{transform:translate(0);opacity:0}82%{transform:translate(5px,-1px);opacity:.9}86%{transform:translate(-4px,1px);opacity:.9}90%{opacity:0}}
.typed{margin-top:20px;font-family:var(--fd);font-size:clamp(.9rem,2.6vw,1.2rem);color:var(--mut);min-height:1.7em}
.typed b{color:var(--tx);font-weight:500}
.typed::after{content:"▍";color:var(--c1);animation:blink .8s infinite}
@keyframes blink{50%{opacity:0}}
.lead{max-width:560px;margin-top:16px;color:#b9c0d2;font-size:1.04rem}
@keyframes spin{to{transform:rotate(360deg)}}

/* marquee */
.mq{border-block:1px solid var(--line);background:rgba(8,10,20,.7);overflow:hidden;padding:16px 0;position:relative;z-index:1}
.mq div{display:flex;gap:46px;width:max-content;animation:mq 26s linear infinite}
.mq span{font-family:var(--fd);font-weight:700;font-size:clamp(1rem,3vw,1.6rem);letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.5)}
.mq span:nth-child(3n+1){color:var(--c1);-webkit-text-stroke:0;text-shadow:0 0 16px rgba(0,229,255,.6)}
@keyframes mq{to{transform:translateX(-50%)}}

/* titles */
.eyebrow{font-size:.74rem;letter-spacing:.34em;text-transform:uppercase;color:var(--c3);margin-bottom:12px}
h2{font-family:var(--fd);font-weight:900;font-size:clamp(1.6rem,5.4vw,3.1rem);text-transform:uppercase;line-height:1.1;margin-bottom:18px}
h2 em{font-style:normal;color:var(--c1);text-shadow:0 0 18px rgba(0,229,255,.5)}
.sub{color:var(--mut);max-width:640px;margin-bottom:44px}
.rv{opacity:0;transform:translateY(44px);transition:opacity .9s cubic-bezier(.2,.7,.2,1) var(--d,0s),transform .9s cubic-bezier(.2,.7,.2,1) var(--d,0s)}
.rv.in{opacity:1;transform:none}
.rv.l{transform:translateX(-60px)}.rv.r{transform:translateX(60px)}.rv.l.in,.rv.r.in{transform:none}

/* stats */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(170px,100%),1fr));gap:16px}
.stat{padding:26px 20px;border-radius:16px;background:var(--glass);border:1px solid var(--line);position:relative;overflow:hidden;transition:.4s}
.stat::before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(0,229,255,.14),transparent 70%);transform:translateX(-120%);transition:transform .8s}
.stat:hover{border-color:var(--c1);transform:translateY(-6px);box-shadow:0 10px 40px rgba(0,229,255,.15)}
.stat:hover::before{transform:translateX(120%)}
.num{display:block;font-family:var(--fd);font-weight:900;font-size:clamp(1.7rem,4.2vw,2.5rem);color:var(--c1);text-shadow:0 0 20px rgba(0,229,255,.4);line-height:1.1}
.stat p{margin-top:8px;color:var(--mut);font-size:.88rem}
.src{margin-top:18px;font-size:.78rem;color:var(--mut)}

/* story */
.story{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(30px,6vw,80px);align-items:start}
.sticky{position:sticky;top:100px}
.pic{position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line)}
.pic::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 60%,rgba(5,6,11,.8)),linear-gradient(135deg,rgba(139,92,246,.18),transparent 50%)}
.pic figcaption{position:absolute;left:16px;bottom:14px;z-index:2;font-size:.8rem;letter-spacing:.12em;color:var(--tx);text-transform:uppercase}
.chap{padding:26px 26px;border-radius:16px;background:var(--glass);border:1px solid var(--line);margin-bottom:18px;transition:.4s}
.chap:hover{border-color:var(--c2);transform:translateX(8px)}
.chap h3{font-family:var(--fd);font-size:1.05rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}
.chap h3 small{display:block;font-family:var(--fb);font-size:.72rem;letter-spacing:.25em;color:var(--c1);margin-bottom:4px}
.chap p{color:#b9c0d2}
@media(max-width:860px){.story{grid-template-columns:1fr}.sticky{position:relative;top:0}}

/* before after */
.ba-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,64px);align-items:center}
.ba{position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line);aspect-ratio:1;user-select:none;-webkit-user-select:none;touch-action:pan-y;box-shadow:0 0 60px rgba(139,92,246,.22)}
.ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ba .top{clip-path:inset(0 calc(100% - var(--p,50%)) 0 0)}
.ba .hd2{position:absolute;top:0;bottom:0;left:var(--p,50%);width:2px;background:var(--c1);box-shadow:0 0 14px var(--c1);transform:translateX(-1px);pointer-events:none}
.ba .hd2::after{content:"⇆";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:42px;height:42px;border-radius:50%;background:#05060b;border:2px solid var(--c1);display:grid;place-items:center;color:var(--c1);font-size:1rem}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
.lb{position:absolute;bottom:12px;z-index:2;padding:4px 12px;border-radius:100px;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;background:rgba(5,6,11,.75);border:1px solid var(--line)}
.lb.a{left:12px}.lb.b{right:12px;color:var(--c1);border-color:var(--c1)}
.cmp{display:grid;gap:14px}
.cmp div{padding:20px 22px;border-radius:14px;background:var(--glass);border:1px solid var(--line)}
.cmp h3{font-family:var(--fd);font-size:.95rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px;color:var(--c3)}
.cmp div:last-child h3{color:var(--c1)}
.cmp p{color:#b9c0d2;font-size:.97rem}
@media(max-width:860px){.ba-grid{grid-template-columns:1fr}}

/* timeline cards */
.tl{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(250px,100%),1fr));gap:16px}
.tc{position:relative;padding:24px 22px;border-radius:16px;background:var(--glass);border:1px solid var(--line);overflow:hidden;transition:.4s;transform-style:preserve-3d}
.tc.in,.cc.in{transition:border-color .4s,box-shadow .4s,transform .15s}
.tc:hover{border-color:var(--c1);box-shadow:0 14px 44px rgba(0,229,255,.14)}
.tc .y{font-family:var(--fd);font-weight:900;font-size:2.3rem;color:transparent;-webkit-text-stroke:1px var(--c2);line-height:1}
.tc .m{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--c1);margin:10px 0 4px}
.tc h3{font-size:1.02rem;margin-bottom:6px}
.tc p{color:var(--mut);font-size:.92rem}

/* genres */
.gen{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(180px,100%),1fr));gap:14px}
.g{padding:24px 18px 22px;border-radius:16px;border:1px solid var(--line);background:var(--glass);text-align:center;transition:.4s}
.g:hover{transform:translateY(-8px);border-color:var(--c2);box-shadow:0 12px 40px rgba(139,92,246,.25)}
.g h3{font-family:var(--fd);font-size:1.05rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
.bar{height:6px;border-radius:6px;background:rgba(255,255,255,.08);overflow:hidden}
.skills{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}
.sk{padding:9px 16px;border-radius:100px;border:1px solid var(--line);background:rgba(255,255,255,.03);font-size:.86rem;transition:.3s}
.sk:hover{border-color:var(--c1);color:var(--c1);box-shadow:0 0 18px rgba(0,229,255,.25)}

/* beat lab */
.lab{border-radius:20px;border:1px solid var(--line);background:linear-gradient(160deg,rgba(14,17,30,.85),rgba(10,12,22,.85));padding:clamp(16px,3vw,30px);box-shadow:0 0 70px rgba(0,229,255,.08)}
#viz{width:100%;height:110px;display:block;border-radius:12px;background:rgba(0,0,0,.35);margin-bottom:18px}
.ctl{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-bottom:18px}
.ctl label{font-size:.8rem;color:var(--mut);display:flex;align-items:center;gap:10px}
.ctl output{font-family:var(--fd);color:var(--c1);min-width:3ch}
input[type=range]{accent-color:var(--c1)}
.seq{display:grid;gap:8px}
.row span{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
.pad{aspect-ratio:1;min-height:0;border-radius:6px;border:1px solid var(--line);background:rgba(255,255,255,.04);cursor:pointer;transition:background .12s,box-shadow .12s,transform .12s;padding:0}
.pad.o{background:var(--c1);box-shadow:0 0 12px var(--c1);border-color:var(--c1)}
.row:nth-child(2) .pad.o{background:var(--c3);border-color:var(--c3);box-shadow:0 0 12px var(--c3)}
.row:nth-child(3) .pad.o{background:var(--c2);border-color:var(--c2);box-shadow:0 0 12px var(--c2)}
.pad.now{transform:scale(1.18);border-color:#fff}

/* collabs */
.cb{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:16px}
.cc{position:relative;padding:26px 24px;border-radius:18px;background:var(--glass);border:1px solid var(--line);overflow:hidden;transition:.4s;transform-style:preserve-3d}
.cc:hover{border-color:var(--c3);box-shadow:0 14px 50px rgba(255,45,149,.16)}
.cc .k{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--c3)}
.cc h3{font-family:var(--fd);font-size:1.15rem;margin:8px 0 6px;word-break:break-word}
.cc p{color:var(--mut);font-size:.93rem}
.cc a.lk{display:inline-block;margin-top:12px;font-size:.85rem;color:var(--c1);text-underline-offset:4px}
.eq{display:flex;gap:3px;align-items:flex-end;height:22px;margin-top:16px}
.note{margin-top:22px;color:var(--mut);font-size:.9rem;max-width:680px}

/* gallery */
.gal{columns:3 220px;column-gap:14px}
.gi{break-inside:avoid;margin-bottom:14px;border-radius:14px;overflow:hidden;position:relative;cursor:zoom-in;border:1px solid var(--line)}
.gi span{position:absolute;left:0;right:0;bottom:0;padding:26px 14px 10px;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;background:linear-gradient(transparent,rgba(5,6,11,.9));transform:translateY(100%);transition:.4s}
.gi:hover span{transform:none}
#lbx{position:fixed;inset:0;z-index:400;background:rgba(3,4,8,.94);display:none;align-items:center;justify-content:center;padding:20px;cursor:zoom-out}
#lbx.on{display:flex;animation:fi .3s}
#lbx img{max-height:90vh;max-width:92vw;border-radius:12px;box-shadow:0 0 80px rgba(139,92,246,.4)}
@keyframes fi{from{opacity:0}}

/* quotes */
.qs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(260px,100%),1fr));gap:16px}
.q{padding:30px 26px;border-radius:18px;background:var(--glass);border:1px solid var(--line);font-family:var(--fd);font-size:1.05rem;line-height:1.5;transition:.4s}
.q:hover{border-color:var(--c1);transform:translateY(-6px)}
.q small{display:block;margin-top:14px;font-family:var(--fb);font-size:.78rem;letter-spacing:.14em;color:var(--mut);text-transform:uppercase}

/* contact */
.ct{text-align:center;padding:clamp(40px,7vw,80px) 20px;border-radius:24px;border:1px solid var(--line);background:radial-gradient(600px 300px at 50% 0,rgba(139,92,246,.22),transparent 70%),var(--glass)}
.ct h2{margin-bottom:14px}
.ct p{max-width:560px;margin:0 auto 10px;color:#b9c0d2}
.ct a.tx{color:var(--c1);text-underline-offset:5px;text-decoration-thickness:1px}
.ct a.tx:hover{color:var(--c3)}

/* floating whatsapp - single */
.wa:hover{transform:scale(1.1)}
.wa svg{width:26px;height:26px;fill:#fff}

footer{border-top:1px solid var(--line);padding:34px 0 40px;text-align:center;color:var(--mut);font-size:.85rem;background:rgba(5,6,11,.85)}
footer p+p{margin-top:4px}

@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}html{scroll-behavior:auto}.rv{opacity:1;transform:none}}

#fx{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
/* ===== v2: leve, sidebar fosca, hero e responsivo ===== */
#progress{position:fixed;top:0;left:0;height:3px;width:100%;transform:scaleX(0);transform-origin:0 50%;will-change:transform;background:linear-gradient(90deg,var(--c1),var(--c2),var(--c3));z-index:200}
.cursor{position:fixed;left:-17px;top:-17px;width:34px;height:34px;border:1.5px solid var(--c1);border-radius:50%;pointer-events:none;z-index:300;display:none;will-change:transform;transition:background .25s,border-color .25s}
.cursor.big{background:rgba(0,229,255,.14);border-color:var(--c3)}

/* header */
header{position:fixed;top:0;left:0;right:0;z-index:100;padding:calc(env(safe-area-inset-top,0px) + 10px) 0 10px;transition:background .3s,border-color .3s;border-bottom:1px solid transparent}
header.sc{background:rgba(5,6,11,.94);border-color:var(--line)}
.hd{display:flex;align-items:center;justify-content:center;min-height:44px}
.dnav ul{display:flex;gap:clamp(14px,2.2vw,28px);list-style:none}
.dnav a{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:var(--mut);transition:color .25s}
.dnav a:hover,.dnav a.on{color:var(--c1)}
.burger{display:none;margin-left:auto;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;width:44px;height:44px;cursor:pointer;position:relative;-webkit-tap-highlight-color:transparent}
.burger i{position:absolute;left:11px;right:11px;height:2px;background:var(--tx);border-radius:2px}
.burger i:nth-child(1){top:15px}.burger i:nth-child(2){top:21px}.burger i:nth-child(3){top:27px}

/* sidebar (menu mobile) com fundo fosco */
.scrim{position:fixed;inset:0;z-index:110;background:rgba(3,4,8,.5);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:opacity .3s,visibility .3s}
.side{position:fixed;top:0;right:0;bottom:0;width:min(84vw,340px);z-index:120;padding:calc(env(safe-area-inset-top,0px) + 76px) 26px 30px;background:rgba(12,14,26,.6);-webkit-backdrop-filter:blur(22px) saturate(140%);backdrop-filter:blur(22px) saturate(140%);border-left:1px solid var(--line);transform:translate3d(105%,0,0);visibility:hidden;transition:transform .38s cubic-bezier(.2,.8,.2,1),visibility .38s;overflow:hidden}
.side ul{list-style:none;display:grid}
.side a{display:block;padding:15px 4px;font-family:var(--fd);font-size:.98rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--tx);border-bottom:1px solid var(--line);-webkit-tap-highlight-color:transparent}
.side a.on,.side a:active{color:var(--c1)}
.sx{position:absolute;top:calc(env(safe-area-inset-top,0px) + 10px);right:14px;width:44px;height:44px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--tx);font-size:1.7rem;line-height:1;cursor:pointer}
body.menu .scrim{opacity:1;visibility:visible}
body.menu .side{transform:none;visibility:visible}
@media(max-width:980px){.dnav{display:none}.burger{display:block}.hd{justify-content:flex-end}}
@media(min-width:981px){.side,.scrim{display:none}}

/* hero */
.hero{padding-top:clamp(96px,13vw,120px)}
.vis{display:flex;flex-direction:column;align-items:center;position:relative}
.pw{position:relative;width:min(100%,430px);aspect-ratio:1;display:grid;place-items:center}
.pw::after{content:"";position:absolute;left:14%;right:14%;bottom:-30px;height:40px;border-radius:50%;background:radial-gradient(closest-side,rgba(139,92,246,.5),transparent);pointer-events:none}
.glow{position:absolute;inset:4%;border-radius:50%;background:radial-gradient(closest-side,rgba(139,92,246,.5),transparent 75%)}
.orb{position:absolute;inset:-5%;border-radius:50%;background:conic-gradient(from 0deg,var(--c1),var(--c2),var(--c3),var(--c1));-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 2px));animation:spin 9s linear infinite;opacity:.8;will-change:transform}
.orb.b{inset:-11%;animation-duration:16s;animation-direction:reverse;opacity:.3}
.frame{position:relative;width:100%;height:100%;border-radius:50%;overflow:hidden;border:2px solid rgba(255,255,255,.14);will-change:transform;transition:transform .2s ease-out}
.frame img{width:100%;height:100%;object-fit:cover}
.frame::after{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,229,255,.2),rgba(139,92,246,.22) 60%,rgba(255,45,149,.15))}
.eqs{display:flex;align-items:flex-end;gap:3px;height:44px;width:min(100%,430px);margin:44px auto 0}
.eqs i{flex:1;height:100%;border-radius:2px;background:linear-gradient(var(--c1),var(--c2) 60%,var(--c3));transform-origin:bottom;transform:scaleY(.15);animation:eqs 1.1s ease-in-out infinite;animation-delay:calc(var(--i)*-.11s);will-change:transform}
.eqs i:nth-child(3n){animation-duration:.85s}.eqs i:nth-child(4n){animation-duration:1.4s}
@keyframes eqs{0%,100%{transform:scaleY(.15)}50%{transform:scaleY(1)}}
.mini{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:min(100%,430px);margin:16px auto 0}
.chip{position:static;padding:12px 8px;border-radius:12px;background:var(--glass);border:1px solid var(--line);font-size:.76rem;color:var(--mut);text-align:center;transition:border-color .3s,transform .3s}
.chip:hover{border-color:var(--c1);transform:translateY(-4px)}
.chip b{display:block;font-family:var(--fd);font-size:clamp(.92rem,3.4vw,1.15rem);color:var(--c1);line-height:1.2}
