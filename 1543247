// ===== Reveal, contadores, scramble =====
const chars="01<>/\\|#$%&ABCDEF";
function scramble(el){
 const txt=el.dataset.t||(el.dataset.t=el.textContent);
 if(REDUCED)return;
 let f=0;const n=20;
 const iv=setInterval(()=>{
  f++;el.textContent=[...txt].map((c,i)=>c===" "?" ":(i<txt.length*f/n?c:chars[Math.random()*chars.length|0])).join("");
  if(f>=n){clearInterval(iv);el.textContent=txt}
 },40);
}
function fmt(el,v){const dec=+el.dataset.dec||0;return (el.dataset.pre||"")+v.toLocaleString("pt-PT",{minimumFractionDigits:dec,maximumFractionDigits:dec})+(el.dataset.suf||"")}
function count(el){
 const to=parseFloat(el.dataset.to),t0=performance.now(),d=1800;
 (function step(t){
  const p=Math.min((t-t0)/d,1),e=1-Math.pow(1-p,4);
  el.textContent=fmt(el,to*e);
  if(p<1)requestAnimationFrame(step);
 })(t0);
}
function scrambleTitle(el){
 el.childNodes.forEach(n=>{if(n.nodeType===3&&n.textContent.trim()){
  const sp=document.createElement("span");sp.textContent=n.textContent;n.replaceWith(sp);scramble(sp)}});
}
const io=new IntersectionObserver(es=>es.forEach(e=>{
 if(!e.isIntersecting)return;
 const el=e.target;el.classList.add("in");io.unobserve(el);
 if(el.classList.contains("scr"))scrambleTitle(el);
 el.querySelectorAll(".num").forEach(count);
}),{threshold:.12});
$$(".rv").forEach(el=>io.observe(el));

